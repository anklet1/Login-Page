<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Vote</title>
	<link rel="stylesheet" href="/static/css/styles.css" />
</head>
<body>
	<div class="container">
		<header>
			<a href="/">← Back</a>
			<h1>Vote</h1>
			<a href="/poll/<%= poll.id %>/results">Results</a>
		</header>
		<form class="card" method="post" action="/poll/<%= poll.id %>/vote">
			<div><strong><%= poll.question %></strong></div>
			<% options.forEach(o => { %>
				<label class="row">
					<input type="radio" name="option" value="<%= o.id %>" required />
					<span><%= o.label %></span>
				</label>
			<% }) %>
			<div class="row" style="justify-content: flex-end">
				<button type="submit">Submit vote</button>
			</div>
		</form>
	</div>
</body>
</html>
